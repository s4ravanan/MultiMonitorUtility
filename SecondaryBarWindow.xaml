<Window x:Class="MultiMonitorUtility.SecondaryBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="DarkBlue">

    <Grid>
        <TextBlock x:Name="DebugText"
           Foreground="White"
           FontSize="16"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
    </Grid>

</Window>